# Copy to .env for local work (it is git-ignored). On Render these go in the service's Environment page.
# Every value below is a harmless example. Never put a real secret in this file.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Public address of this service, for links and later for token audiences.
PUBLIC_BASE_URL=http://localhost:3000

# Websites allowed to call this API from a browser (comma separated, origin only: no path, no trailing slash).
# In production every entry must be https.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# Set to true behind Render's proxy so the real client address is used for rate limits and logs.
TRUST_PROXY=false

# Rate limit per client address.
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_S=60

# Largest request body accepted, in bytes.
BODY_LIMIT_BYTES=262144

# How long /readyz waits for each dependency check, in milliseconds.
READINESS_TIMEOUT_MS=2000
