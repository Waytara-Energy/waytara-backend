# Copy to .env for local work (it is git-ignored). On Render these go in the service's Environment page.
# Every value below is a harmless example. Never put a real secret in this file.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Public address of this service, for links and later for token audiences.
PUBLIC_BASE_URL=http://localhost:3000

# Websites allowed to call this API from a browser (comma separated, origin only: no path, no trailing slash).
# In production every entry must be https.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# Set to true behind Render's proxy so the real client address is used for rate limits and logs.
TRUST_PROXY=false

# Rate limit per client address.
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_S=60

# Largest request body accepted, in bytes.
BODY_LIMIT_BYTES=262144

# How long /readyz waits for each dependency check, in milliseconds.
READINESS_TIMEOUT_MS=2000

# --- Database (task A4a). All of these four together, or none of them (none: the key endpoints are switched off in development).
# The backend signs in to Supabase as its own service user. It never holds the service_role key.
SUPABASE_URL=https://yxenvzcfypfqzbpfyuiz.supabase.co
SUPABASE_ANON_KEY=replace-with-the-public-anon-key-from-Supabase-Settings-API
SUPABASE_SERVICE_USER_EMAIL=backend@waytaraenergy.com
SUPABASE_SERVICE_USER_PASSWORD=replace-with-the-password-from-your-password-manager

# 32 random bytes in base64 (44 characters), used to encrypt equipment keys before they are stored. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it in your password manager. If it is lost, every stored key must be re-issued.
KEY_ENCRYPTION_MASTER=replace-with-44-characters-from-the-command-above
# Only while rotating the master: the old one, so existing keys still open.
# KEY_ENCRYPTION_MASTER_PREVIOUS=

# The MQTT broker and the data intake run by default; false switches them off (the key and claim endpoints stay).
# GATEWAY_INGEST=true
