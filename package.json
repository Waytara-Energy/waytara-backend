{
  "name": "waytara-backend",
  "version": "0.1.0",
  "private": true,
  "description": "WayTara gateway backend: MQTT ingest, decoding, storage, live relay, commands and OCPP",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:supabase": "tsx --env-file-if-exists=.env scripts/check-supabase.ts",
    "check:render": "tsx --env-file=.env.render scripts/check-supabase.ts",
    "check:r2": "tsx --env-file-if-exists=.env scripts/check-r2.ts",
    "check:render-r2": "tsx --env-file=.env.render scripts/check-r2.ts",
    "inspect:ocpp-log": "tsx --env-file=.env.render scripts/inspect-ocpp-log.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/websocket": "^11.3.4",
    "@msgpack/msgpack": "^3.1.3",
    "@supabase/supabase-js": "^2.117.3",
    "aedes": "^1.2.0",
    "fastify": "^5.12.7",
    "jose": "^6.2.12",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "eslint": "^10.12.0",
    "mqtt": "^5.16.1",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
